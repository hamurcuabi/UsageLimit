rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function childData(childId) {
      return get(/databases/$(database)/documents/children/$(childId)).data;
    }

    // Çocuk kaydını açan ebeveyn
    function isParentOf(childId) {
      return signedIn() && childData(childId).parentUid == request.auth.uid;
    }

    // O kayıtla eşleşmiş çocuk telefonu
    function isDeviceOf(childId) {
      return signedIn() && childData(childId).deviceUid == request.auth.uid;
    }

    // Ebeveynin bildirim jetonları
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Eşleştirme kodları: kodu bilen okuyabilir, listelenemez.
    match /pairCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.parentUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.parentUid == request.auth.uid;
    }

    match /children/{childId} {
      allow create: if signedIn() && request.resource.data.parentUid == request.auth.uid;
      allow read, delete: if signedIn() && resource.data.parentUid == request.auth.uid;
      allow get: if signedIn() && resource.data.deviceUid == request.auth.uid;

      allow update: if signedIn() && (
        // Ebeveyn kendi kaydını günceller (sahipliği değiştiremez).
        (resource.data.parentUid == request.auth.uid
          && request.resource.data.parentUid == resource.data.parentUid)
        // Eşleşme: boş kayda, doğru kodu bilen cihaz bağlanır.
        || (resource.data.deviceUid == null
          && request.resource.data.deviceUid == request.auth.uid
          && request.resource.data.claimCode == resource.data.pairCode
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['deviceUid', 'claimCode', 'deviceModel', 'pairedAt']))
        // Eşleşmiş cihaz yalnızca durum alanlarını yazar.
        || (resource.data.deviceUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['lastSeen', 'totalTodayMs', 'status']))
      );

      // Limitler: yalnızca ebeveyn yazar, çocuk telefonu sadece okur.
      match /config/{doc} {
        allow read: if isParentOf(childId) || isDeviceOf(childId);
        allow write: if isParentOf(childId);
      }

      // Kullanım verisi: çocuk telefonu yazar, ebeveyn okur.
      match /snapshots/{doc} {
        allow read: if isParentOf(childId) || isDeviceOf(childId);
        allow create, update: if isDeviceOf(childId);
        allow delete: if isParentOf(childId);
      }

      // Olaylar: çocuk telefonu yalnızca ekler (değiştiremez, silemez), ebeveyn okur.
      match /events/{eventId} {
        allow create: if isDeviceOf(childId);
        allow read, delete: if isParentOf(childId);
      }
    }
  }
}
